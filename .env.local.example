# ── Environment Variables for NGX Pulse ──────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase (frontend, safe to expose to the browser) ────────────
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# ── Supabase (server-side only — GitHub Actions secrets) ──────────
# Used by python/scraper.py to write. Bypasses RLS. NEVER expose.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# ── Mansa API (Python scraper) ────────────────────────────────────
# https://mansaapi.com — note the Free plan allows 100 requests/day
MANSA_API_KEY=mansa_live_sk_YOUR_KEY

# ── GitHub Actions ────────────────────────────────────────────────
# Add these under: repo > Settings > Secrets and variables > Actions
#   MANSA_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY
